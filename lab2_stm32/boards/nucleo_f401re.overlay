/*
 * Pin plan for 3.1. SUGGESTED pins - verify in DS10086 / UM1724.
 *   ENA PA8 [D7]  TIM1_CH1     ENB PA9 [D8]  TIM1_CH2
 *   IN1 PA10 [D2] IN2 PB5 [D4] IN3 PC7 [D9]  IN4 PB0 [A3]
 *   Encoder L: PA6 [D12] / PA7 [D11]  TIM3
 *   Encoder R: PB6 [D10] / PB7 [CN7-21] TIM4
 *
 * Blinkers (3.4): plain GPIO, timed by a k_timer in blinker.c
 *   Left  (LED 0/1): LED0 PA15 [CN7-17]  LED1 PA0 [A0]
 *   Right (LED 2/3): LED2 PA1  [A1]      LED3 PB3 [D3]
 *
 * Current sensor ADC1: PA4 [A2] IN4, PC1 [A4] IN11, PC0 [A5] IN10
 *
 * Pi <-> STM32 link on USART6:
 *   PA11 = USART6_TX (CN10-14) -> Pi pin 10 (GPIO15 RXD)
 *   PA12 = USART6_RX (CN10-12) <- Pi pin 8  (GPIO14 TXD)
 * PA11/PA12 are the MCU's USB pins, unused on the Nucleo, so they don't clash
 * with the motor/servo PWM pins. USART2 (PA2/PA3) stays the ST-Link USB
 * console for printk.
 * CMD_RX test point on PC8 (CN10-2).
 *
 * Steering servo (3.3): PB10 [D6] = TIM2_CH3, 50 Hz. TIM2 was the board's
 * LED PWM on PA5; LD2 is used as a plain GPIO instead, so that is disabled.
 *
 * Zephyr ignores app.overlay when this board overlay exists, so everything
 * lives here.
 */
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/sensor/qdec_stm32.h>
#include <zephyr/dt-bindings/adc/adc.h>

/ {
	aliases {
		link-uart = &usart6;
		qdec-left = &qdec_left;
		qdec-right = &qdec_right;
	};

	zephyr,user {
		cmdrx-gpios = <&gpioc 8 GPIO_ACTIVE_HIGH>;
		/* PWM_SET test point (row 6): toggles each time motor.c writes a duty */
		pwmset-gpios = <&gpioc 9 GPIO_ACTIVE_HIGH>;   /* PC9 [CN10-1] */

		/* 20 kHz motor PWM */
		pwms = <&motor_pwm 1 PWM_USEC(50) PWM_POLARITY_NORMAL>,
		       <&motor_pwm 2 PWM_USEC(50) PWM_POLARITY_NORMAL>,
		       <&servo_pwm 3 PWM_MSEC(20) PWM_POLARITY_NORMAL>;  /* servo */
		/* IN1, IN2 (left), IN3, IN4 (right) */
		motor-dir-gpios = <&gpioa 10 GPIO_ACTIVE_HIGH>,
				  <&gpiob 5 GPIO_ACTIVE_HIGH>,
				  <&gpioc 7 GPIO_ACTIVE_HIGH>,
				  <&gpiob 0 GPIO_ACTIVE_HIGH>;

		/* current sensors: PC0 (IN10), PA4 (IN4), PC1 (IN11) */
		io-channels = <&adc1 10>, <&adc1 4>, <&adc1 11>;
	};
};

/* The board file puts these on pins we need - turn them off. */
&usart1 { status = "disabled"; };  /* PB6/PB7 */
&spi1   { status = "disabled"; };  /* PA5-PA7, PB6 */
&i2c3   { status = "disabled"; };  /* PA8 */
&i2c1   { status = "disabled"; };  /* PB8/PB9 */

/* Servo PWM: TIM2 channel 3 on PB10. Replaces the board's LED PWM on PA5. */
&{/pwmleds} { status = "disabled"; };
&timers2 {
	status = "okay";
	st,prescaler = <0>;
	servo_pwm: pwm {
		status = "okay";
		pinctrl-0 = <&tim2_ch3_pb10>;
		pinctrl-names = "default";
	};
};

&usart6 {
	pinctrl-0 = <&usart6_tx_pa11 &usart6_rx_pa12>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&timers1 {
	status = "okay";
	st,prescaler = <0>;
	motor_pwm: pwm {
		status = "okay";
		pinctrl-0 = <&tim1_ch1_pa8 &tim1_ch2_pa9>;
		pinctrl-names = "default";
	};
};

/* Encoder mode 3 = count every edge of A and B (x4). */
&timers3 {
	status = "okay";
	st,prescaler = <0>;
	qdec_left: qdec {
		status = "okay";
		pinctrl-0 = <&tim3_ch1_pa6 &tim3_ch2_pa7>;
		pinctrl-names = "default";
		st,encoder-mode = <0x3>;
		st,input-filter-level = <FDIV32_N8>;
		st,counts-per-revolution = <1>;
	};
};

&timers4 {
	status = "okay";
	st,prescaler = <0>;
	qdec_right: qdec {
		status = "okay";
		pinctrl-0 = <&tim4_ch1_pb6 &tim4_ch2_pb7>;
		pinctrl-names = "default";
		st,encoder-mode = <0x3>;
		st,input-filter-level = <FDIV32_N8>;
		st,counts-per-revolution = <1>;
	};
};

&tim3_ch1_pa6 { bias-pull-up; };
&tim3_ch2_pa7 { bias-pull-up; };
&tim4_ch1_pb6 { bias-pull-up; };
&tim4_ch2_pb7 { bias-pull-up; };

/* Blinkers: plain GPIO outputs, toggled by a k_timer in blinker.c (TIM2 is
 * the servo's timer, and a timer can only have one period). Looked up by
 * label in blinker.c: LED 0-1 = left (front, rear), 2-3 = right.
 */
/ {
	blink_leds {
		compatible = "gpio-leds";

		blink_led_0: blink_led_0 {
			gpios = <&gpioa 15 GPIO_ACTIVE_HIGH>; /* PA15 [CN7-17] */
		};

		blink_led_1: blink_led_1 {
			gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;  /* PA0 [A0] */
		};

		blink_led_2: blink_led_2 {
			gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;  /* PA1 [A1] */
		};

		blink_led_3: blink_led_3 {
			gpios = <&gpiob 3 GPIO_ACTIVE_HIGH>;  /* PB3 [D3] */
		};
	};
};

// current sensor
&adc1 {
	pinctrl-0 = <&adc1_in10_pc0 &adc1_in4_pa4 &adc1_in11_pc1>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@a {
		reg = <10>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@b {
		reg = <11>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};
};
